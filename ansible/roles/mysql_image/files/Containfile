FROM rockylinux:9

ENV LANG=C.UTF-8
ENV MYSQL_DATA=/var/lib/mysql
ENV CERT_DIR=/etc/mysql_certs
ENV MARIADB_HOME=/usr/local/mysql
ENV MARIADB_VERSION=12.0.2
ENV GOSU_VERSION=1.16

# Install system dependencies and resolve curl conflict safely
RUN dnf -y install --allowerasing curl jq tar openssl procps which shadow-utils \
    python3 python3-pip python3-devel gcc gcc-c++ make && \
    dnf clean all

# Install gosu for safe user switching
RUN curl -L -o /usr/local/bin/gosu "https://github.com/tianon/gosu/releases/download/${GOSU_VERSION}/gosu-amd64" && \
    chmod +x /usr/local/bin/gosu && \
    gosu nobody true

# Download and install MariaDB binary tarball
WORKDIR /usr/local
RUN curl -L "https://mirror.mariadb.org/mariadb-${MARIADB_VERSION}/bintar-linux-x86_64/mariadb-${MARIADB_VERSION}-linux-x86_64.tar.gz" \
    -o mariadb.tar.gz && \
    tar -xzf mariadb.tar.gz && \
    mv mariadb-${MARIADB_VERSION}-linux-x86_64 mysql && \
    rm mariadb.tar.gz

ENV PATH="${MARIADB_HOME}/bin:$PATH"

# Install Python DB clients
RUN pip3 install --no-cache-dir mysqlclient PyMySQL

# Copy entrypoint and CA generation scripts
COPY root-entrypoint.sh /usr/local/bin/root-entrypoint.sh
COPY generate_ca.sh /usr/local/bin/generate_ca.sh
RUN chmod +x /usr/local/bin/root-entrypoint.sh /usr/local/bin/generate_ca.sh

# Create mysql user for gosu
RUN useradd -r -s /sbin/nologin mysql

EXPOSE 3306
VOLUME ["/var/lib/mysql", "/etc/mysql_certs"]

ENTRYPOINT ["/usr/local/bin/root-entrypoint.sh"]
CMD ["mariadbd"]
